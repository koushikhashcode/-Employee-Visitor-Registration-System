# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example local: mongodb://localhost:27017/frontdesk
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/frontdesk?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/frontdesk

# Client API URL (for standalone client build if hosted on different port/domain)
VITE_API_URL=/api
