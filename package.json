{
  "name": "front-desk-visitor-registration-system",
  "version": "1.0.0",
  "description": "Full-stack Visitor Registration System (MERN)",
  "type": "module",
  "scripts": {
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:all": "npm run install:client && npm run install:server",
    "build:client": "npm --prefix client run build",
    "build": "npm run install:client && npm run build:client && npm run install:server",
    "start": "NODE_ENV=production node server/server.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "keywords": [
    "visitor-registration",
    "front-desk",
    "mern",
    "express",
    "react",
    "mongodb"
  ],
  "author": "",
  "license": "MIT"
}
